BACKEND_URL=http://localhost:3000
# Keep legacy while running the current backend. Switch to v2 only when the
# documented /api/v1 and realtime V2 contracts are enabled server-side.
BACKEND_CONTRACT=legacy

# Google Sign-In. GOOGLE_SERVER_CLIENT_ID is the *Web* OAuth client id; it is
# what makes Android return an OpenID Connect id token, and its project must
# also hold the Android OAuth client (matched by package name + signing SHA-1).
# GOOGLE_CLIENT_ID is the iOS client id (unused on Android).
# Release/CI builds pass these with
#   --dart-define=GOOGLE_SERVER_CLIENT_ID=…apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_CLIENT_ID=
