# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration
# Set up a local PostgreSQL database and provide the connection URL here
DATABASE_URL="postgresql://user:password@localhost:5432/draughts_arena?schema=public"

# Redis configuration
REDIS_URL="redis://localhost:6379"

# JWT Auth
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"

# Admin CORS Origin (required in production, optional in dev)
ADMIN_CORS_ORIGIN="http://localhost:5173"

# Paystack (Primary gateway — Phase 1 NGN)
PAYSTACK_SECRET_KEY="sk_test_..."

# Flutterwave (Secondary gateway — Phase 1 NGN)
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
FLUTTERWAVE_SECRET_HASH="your-flutterwave-webhook-secret-hash"

# Firebase Cloud Messaging
# Requires downloading a serviceAccountKey.json from Firebase console
FIREBASE_SERVICE_ACCOUNT_KEY="{...}"

