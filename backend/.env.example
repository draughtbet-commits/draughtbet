# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration
# Must match the credentials in docker-compose.yml. A fresh stack initializes
# Postgres with the dev defaults below; changing them against an existing
# volume requires `docker compose down -v` first.
DATABASE_URL="postgresql://draughts_arena:change_me_draughts_arena@127.0.0.1:5432/draughts_arena?schema=public"

# Redis configuration
# Carries the requirepass set in docker-compose.yml.
REDIS_URL="redis://:change_me_draughts_redis@127.0.0.1:6379"

# JWT Auth
# Generate a strong random value for any real deployment, e.g.
#   openssl rand -hex 64
# The sample value below is rejected at production startup.
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"

# Admin CORS Origin (required in production, optional in dev)
ADMIN_CORS_ORIGIN="http://localhost:5173"

# App-version enforcement (opt-in; unset = disabled).
# Supported shapes (set one or both):
#   MIN_APP_VERSION=2.1.0            -> floor: any version >= 2.1.0 is accepted
#   SUPPORTED_APP_VERSIONS=2.1.0,2.1.1  -> exact version allowlist
# Unsupported clients get HTTP 426 UPGRADE_REQUIRED (and are refused at the
# socket handshake with a connect_error). The guard applies to
# /auth/register, /auth/login, /auth/refresh and socket authentication.
#MIN_APP_VERSION="2.1.0"
#SUPPORTED_APP_VERSIONS="2.1.0,2.1.1"

# Paystack (Primary gateway — Phase 1 NGN)
PAYSTACK_SECRET_KEY="sk_test_..."
# Where Paystack returns the player after a 3-D Secure redirect. Omit to leave
# Paystack on its own success page.
PAYSTACK_CALLBACK_URL="https://draughtbet.com/payment/callback"

# Flutterwave (Secondary gateway — Phase 1 NGN)
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
FLUTTERWAVE_SECRET_HASH="your-flutterwave-webhook-secret-hash"

# KYC verification provider: "simulated" (test only) or "dojah".
# No fallback: createKycProvider() throws when unset, so a deployment that
# forgets this cannot verify anyone rather than approving everyone. "simulated"
# approves anyone and is refused outright when NODE_ENV=production.
KYC_PROVIDER="simulated"

# Only read when KYC_PROVIDER="simulated". "pass" verifies immediately, "fail"
# rejects, and "pending" leaves the attempt open so the in-review UI and the
# admin approve/reject paths stay reachable. Anything else fails to start.
# SIMULATED_KYC_RESULT="pass"

# Dojah eKYC. The provider hosts the ID-capture and liveness experience, so the
# backend only mints a reference and hands back a widget URL; results arrive on
# POST /webhooks/dojah signed with HMAC-SHA256 over the raw body.
# Register the callback once per environment:
#   POST {DOJAH_BASE_URL}/api/v1/webhook/subscribe
#   { "webhook": "https://<public-host>/webhooks/dojah", "service": "kyc_widget" }
# Auth is AppId + the secret sent raw in Authorization (not as a Bearer token).
DOJAH_APP_ID=""
DOJAH_SECRET_KEY=""
# Sandbox is https://sandbox.dojah.io; production is https://api.dojah.io.
DOJAH_BASE_URL="https://sandbox.dojah.io"
# From the Dojah dashboard: the EasyOnboard flow whose widget_id to launch.
DOJAH_WIDGET_ID=""

# Test-only: drives the simulated provider's verdict so the verify harness can
# exercise the failure path. Unset means pass.
#SIMULATED_KYC_RESULT="fail"

# Firebase Cloud Messaging
# Requires downloading a serviceAccountKey.json from Firebase console
FIREBASE_SERVICE_ACCOUNT_KEY="{...}"

# OTP delivery (contact verification + password reset)
#   email   -> HTTP email API (fail-closed: a delivery failure returns 503)
#   mailbox -> dev/test Redis mailbox (e2e driver reads dev:otp-mail:<challengeId>)
#   discard -> test/CI default (code is logged as issued, never the code itself)
# In production an unset/unknown value fails closed (OTP endpoints 503) rather
# than silent-drop. DEV_OTP_MAILBOX=1 is the legacy shortcut for `mailbox`.
#OTP_DELIVERY=email
#EMAIL_API_URL="https://api.resend.com/emails"
#EMAIL_API_KEY="re_..."
#EMAIL_FROM="Draught Bet <no-reply@yourdomain.com>"

