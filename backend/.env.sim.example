# Isolated Local Simulation Environment Template
# Copy to backend/.env.sim and fill in your local PostgreSQL credentials.
# NEVER point DATABASE_URL at Neon (neon.tech) or production/Render databases.

NODE_ENV=development
PORT=3005

# Local PostgreSQL 18 isolated simulation database
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/draughtbet_sim

# Local Windows Redis / Memurai
REDIS_URL=redis://127.0.0.1:6379

# Simulation isolation & offline payment gateway mocking flags
SIMULATION_ENABLED=true
SIMULATION_MOCK_PAYMENTS=true
SIMULATION_ALLOW_NEON=false

# Synthetic JWT & webhook test secrets (local only — replace with unique dev values)
JWT_SECRET=local-sim-jwt-secret-change-me
JWT_REFRESH_SECRET=local-sim-refresh-secret-change-me
PAYSTACK_SECRET_KEY=sk_test_local_sim_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-local-sim-placeholder
FLUTTERWAVE_SECRET_HASH=local-sim-flw-webhook-hash
ADMIN_MFA_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_MFA_ENFORCED=false

ADMIN_CORS_ORIGIN=http://localhost:3001
APP_MIN_VERSION=2.0.0
APP_LATEST_VERSION=2.1.0
SIMULATION_BASE_URL=http://127.0.0.1:3005
