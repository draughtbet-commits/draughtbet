// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?  @unique
  username          String?  @unique
  fullName          String?
  address           String?
  passwordHash      String
  displayName       String?
  avatar            String?  // Predesigned avatar id (no uploads) e.g. avatar_01
  tier              Tier     @default(AMATEUR)
  ageVerified       Boolean  @default(false)
  kycStatus         KycStatus @default(NONE)
  countryCode       String?  // ISO 3166-1 alpha-2, from the server-side geo evidence at registration
  dateOfBirth       DateTime? // persisted claimed date of birth; ageVerified is derived from it
  fcmToken          String?  // Firebase Cloud Messaging token for push notifications
  isBanned          Boolean  @default(false)
  isAdmin           Boolean  @default(false)
  createdAt         DateTime @default(now())
  wallet            Wallet?
  devices           DeviceFingerprint[]
  notifications     Notification[]
  calloutsCreated   Callout[] @relation("CalloutChallenger")
  calloutsAccepted  Callout[] @relation("CalloutAcceptedBy")
  eligibility       Eligibility?
  depositIntents    DepositIntent[]
  // V2 relations
  sessions                UserSession[]
  securityEvents          SecurityEvent[]
  consentRecords          ConsentRecord[]
  verificationCases       VerificationCase[]
  saferPlayProfile        SaferPlayProfile?
  saferPlayEvents         SaferPlayEvent[]
  ledgerAccounts          LedgerAccount[]
  bankAccounts            BankAccount[]
  adminRoleAssignments    AdminRoleAssignment[]
  matchParticipants       MatchParticipant[]
  stakeReservations       StakeReservation[]
  matchReceipts           MatchReceipt[]
  riskEvents              RiskEvent[]
  verificationChallenges  VerificationChallenge[]
  connectionEvents        MatchConnectionEvent[]
  withdrawals             Withdrawal[]
}

enum Tier {
  AMATEUR
  MASTER
  PRO
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
}

model Eligibility {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode    String
  countryAllowed Boolean   @default(false)
  geoVerifiedAt  DateTime  @default(now())
  dateOfBirth    DateTime? // persisted claimed date of birth used for the age check
  ageVerified    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Wallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  // Financial truth lives in the V2 ledger (PLAYER_AVAILABLE etc.); a Wallet
  // row is only a currency holder + lock serialization point for funds flows.
  currency            Currency @default(NGN)
  updatedAt           DateTime @updatedAt
  depositIntents      DepositIntent[]
}
enum Currency {
  NGN
  GBP
}

enum Gateway {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

// Server-created deposit intent, persisted BEFORE any checkout is exposed to
// the user. The webhook is verified against this record (reference, amount,
// currency, wallet, user); credit is derived from it, never from the raw
// webhook body.
model DepositIntent {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id])
  walletId          String
  wallet            Wallet               @relation(fields: [walletId], references: [id])
  gateway           Gateway
  reference         String               @unique // server-generated, echoed to the provider as custom reference/tx_ref
  amountMinorUnits  BigInt               // canonical integer minor units, matching the wallet's currency
  currency          Currency             @default(NGN)
  status            DepositIntentStatus  @default(PENDING)
  authorizationUrl  String?
  appliedAt         DateTime?            // set when the matched webhook credits the wallet
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, status])
}

enum DepositIntentStatus {
  PENDING
  FAILED // provider initiation reported an error; no checkout was exposed
  COMPLETED // matched webhook applied; the credit is durable in the ledger
}

model WithdrawalRequest {
  id                String   @id @default(uuid())
  userId            String
  amountMinorUnits  BigInt
  idempotencyKey    String?  // client-supplied operation key; replay returns the original request
  status            WithdrawalStatus @default(PENDING)
  reviewedBy        String?  // admin User.id
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())

  @@unique([userId, idempotencyKey])
}
enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Match {
  id                String   @id @default(uuid())
  playerLightId     String
  playerDarkId      String
  tier              Tier
  stakeMinorUnits   BigInt   // same minor-unit convention as Wallet — kobo for NGN (Phase 1)
  status            MatchStatus @default(ACTIVE)
  winnerId          String?
  endReason         String?  // e.g. "capture_win" | "draw_threefold" | "draw_king_moves" | "forfeit_disconnect" | "admin_decision"
  // Accepted fee snapshot (PlatformSettings.commissionPercent) at funding time.
  // Settlement must use this, never live settings. NULL only for
  // legacy ACTIVE rows funded before this column existed.
  settlementCommissionPercent Int?
  // Authoritative per-turn deadline snapshot (PlatformSettings.timeControlSeconds)
  // at funding time. Turn expiry is derived from this on the live Redis game
  // state; NULL only for legacy ACTIVE rows funded before the column existed.
  timeControlSeconds Int?
  createdAt         DateTime @default(now())
  endedAt           DateTime?
  moves             MatchMove[]
  outbox            GameOutbox?
  // V2 relations
  participants           MatchParticipant[]
  stakeReservations      StakeReservation[]
  settlements            MatchSettlement[]
  receipts               MatchReceipt[]
  gameEvents             GameEvent[]
  gameState              MatchGameState?
  connectionEvents       MatchConnectionEvent[]
  snapshots              GameStateSnapshot[]
  disputeCases           DisputeCase[]
  // V2 snapshot fields (NULL for legacy ACTIVE rows funded before this migration)
  currency                      Currency?  @default(NGN)
  rulesetVersion                Int?
  configurationVersion          Int?
  cancellationPolicyVersion     Int?
  cancelledAt                   DateTime?
  confirmedAt                   DateTime?
  startedAt                     DateTime?
}
enum MatchStatus {
  PENDING
  ACTIVE
  COMPLETED
  FORFEITED
  DISPUTED
  RELEASED
  // V2 lifecycle states (additive — old values kept for backward compat)
  DRAFT
  OPEN
  FUNDED
  READY
  IN_PLAY
  SETTLED
  CANCELLED
  EXPIRED
}

model MatchMove {
  id                String   @id @default(uuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id])
  moveNumber        Int
  playerId          String
  fromSquare        Int      // standard 1-50 notation
  toSquare          Int
  capturedSquares   Int[]
  isKingMove        Boolean  @default(false)
  boardStateAfter   Json     // full board snapshot — enables fast reconnect and future replay features
  createdAt         DateTime @default(now())
  // V2 fields (NULL for legacy moves)
  clientMoveId      String?  // client-supplied idempotency key
  path              Int[]    // full capture path for multi-jump moves
  stateVersion      Int?     // expected state version at time of move

  @@unique([matchId, moveNumber])
  @@unique([matchId, clientMoveId])
}

model Callout {
  id                String   @id @default(uuid())
  challengerId      String
  challenger        User     @relation("CalloutChallenger", fields: [challengerId], references: [id])
  stakeMinorUnits   BigInt   // validated against the tier's calloutMax*, NOT the tier's normal stakeMax* — see PlatformSettings below
  tier              Tier
  status            CalloutStatus @default(OPEN)
  acceptedBy        String?
  acceptedUser      User?    @relation("CalloutAcceptedBy", fields: [acceptedBy], references: [id])
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([tier, status])
}
enum CalloutStatus {
  OPEN
  ACCEPTED
  EXPIRED
  CANCELLED
}

model DeviceFingerprint {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fingerprintHash String
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model PlatformSettings {
  id                 String @id @default("singleton")
  commissionPercent  Int    @default(10)
  // Seconds a player has to make their move before the deadline sweep forfeits
  // the game. Snapshot each Match onto `Match.timeControlSeconds` at funding.
  timeControlSeconds Int    @default(60)
  // Values below are placeholder NGN kobo amounts — confirm real Nigeria-market stake bounds
  // with the client before launch; these are proportional estimates from the original GBP
  // wireframe figures (~₦600/£1), not a client-confirmed pricing decision.
  amateurStakeMinP   BigInt @default(50000)    // ₦500
  amateurStakeMaxP   BigInt @default(1500000)  // ₦15,000
  masterStakeMinP    BigInt @default(1000000)  // ₦10,000
  masterStakeMaxP    BigInt @default(3000000)  // ₦30,000
  proStakeMinP       BigInt @default(3000000)  // ₦30,000
  proStakeMaxP       BigInt @default(6000000)  // ₦60,000

  // Call-out ceilings are DELIBERATELY separate from and higher than the normal stake bounds above.
  // Per the client's original wireframe: a Master player's normal match stake tops out at ₦30,000,
  // but that same player is eligible to call out (challenge) for up to a much higher amount.
  // Do not validate call-out amounts against *StakeMaxP above — use these fields instead.
  amateurCalloutMaxP BigInt @default(0)         // ₦0 — Amateur is not call-out eligible at all, per wireframe
  masterCalloutMaxP  BigInt @default(15000000)  // ₦150,000 (placeholder, proportional to original £250 ceiling)
  proCalloutMaxP     BigInt @default(30000000)  // ₦300,000 (placeholder, proportional to original £500 ceiling)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  matchId     String?
  type        String   // see 03_BACKEND_SPEC.md §Notifications for the full enum of values in use
  title       String
  message     String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Exactly one notification of a given type per user per match (settlement
  // replay-cleanup must never stack duplicate WIN/LOSS notices).
  @@unique([userId, matchId, type])
  @@index([matchId])
}

// Durable activation record written in the SAME transaction that reserves
// stakes and creates the Match row. Redis is initialized idempotently from this
// record afterwards; a recovery sweep reconstructs (or releases) a match when
// the original process dies between commit and activation.
//   PENDING    -> committed with the reservations, Redis not known-good yet
//   ACTIVATING -> someone holds the claim lease for this row
//   ACTIVATED  -> Redis state is live and playable
//   RELEASED   -> activation abandoned; both stakes credited back exactly once
model GameOutbox {
  id                 String           @id @default(uuid())
  matchId            String           @unique
  match              Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player1Id          String
  player2Id          String
  tier               Tier
  stakeMinorUnits    BigInt           // per-player stake, used by the release refund
  status             GameOutboxStatus @default(PENDING)
  attempts           Int              @default(0)
  lastError          String?
  claimToken         String?          @unique // CAS ownership of the activation attempt
  claimExpiresAt     DateTime?        // lease: a crashed owner loses the claim after this
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, updatedAt])
}
enum GameOutboxStatus {
  PENDING
  ACTIVATING
  ACTIVATED
  RELEASED
}

// =============================================================================
// V2 SCHEMA — additive only. Old models/enums untouched.
// PR 1: Add V2 database schema without removing V1.
// =============================================================================

// ---------------------------------------------------------------------------
// Identity / Security
// ---------------------------------------------------------------------------

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model UserSession {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String        // SHA-256 hash of the opaque refresh token
  family           String        // rotation family id — reuse detection key
  lastRotatedAt    DateTime      @default(now())
  deviceInfo       Json?         // { model, os, appVersion } from the client
  ipAddress        String?
  userAgent        String?
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime      @default(now())

  @@index([userId, status])
  @@index([family])
}

model VerificationChallenge {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ChallengeType
  codeHash     String   // bcrypt/argon2 hash of the OTP code
  expiresAt    DateTime
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, type])
}

enum ChallengeType {
  EMAIL
  PHONE
}

model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  version     String   // version string of the accepted document, e.g. "2.1"
  acceptedAt  DateTime @default(now())
  ipAddress   String?

  @@unique([userId, type, version])
}

enum ConsentType {
  TERMS
  PRIVACY
  KYC_CONSENT
}

model SecurityEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SecurityEventType
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH_REUSE_DETECTED
  TOKEN_REVOKED
  PASSWORD_CHANGED
  SESSION_REVOKED
  ACCOUNT_BANNED
}

// ---------------------------------------------------------------------------
// Verification / KYC
// ---------------------------------------------------------------------------

enum VerificationCaseStatus {
  NOT_REQUIRED
  REQUIRED
  STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model VerificationCase {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      VerificationCaseStatus @default(NOT_REQUIRED)
  provider    String?                // e.g. "dojah", "flutterwave-kyc"
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  checks      VerificationCheck[]

  @@index([userId, status])
}

enum VerificationCheckType {
  ID_DOCUMENT
  SELFIE
  PROOF_OF_ADDRESS
  BVN
  NIN
}

enum VerificationCheckStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

model VerificationCheck {
  id               String                 @id @default(uuid())
  caseId           String
  case             VerificationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type             VerificationCheckType
  status           VerificationCheckStatus @default(PENDING)
  providerResponse Json?
  verifiedAt       DateTime?
  createdAt        DateTime               @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Safer Play
// ---------------------------------------------------------------------------

model SaferPlayProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositLimitMinorUnits    BigInt?   // daily deposit ceiling; NULL = no limit
  stakeLimitMinorUnits      BigInt?   // per-match stake ceiling; NULL = no limit
  timeoutUntil              DateTime? // temporary break — player cannot join matches until this
  selfExcludedUntil         DateTime? // hard self-exclusion — player cannot transact until this
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

enum SaferPlayAction {
  SET
  UPDATED
  LIFTED
}

model SaferPlayEvent {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    SaferPlayAction
  field     String          // e.g. "depositLimitMinorUnits", "selfExcludedUntil"
  oldValue  Json?
  newValue  Json?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Finance — V2 double-entry ledger
// ---------------------------------------------------------------------------

enum AccountType {
  PLAYER_AVAILABLE
  PLAYER_LOCKED
  PLAYER_WITHDRAWAL_PENDING
  PLATFORM_REVENUE
  SYSTEM_OPENING_CLEARING
  SUSPENSE
  // Contra for external funds entering player float. Grows negative as player
  // float grows (system singleton), mirroring SYSTEM_OPENING_CLEARING's sign
  // convention for money the platform holds on players' behalf.
  CUSTOMER_LIABILITY
}

model LedgerAccount {
  id          String      @id @default(uuid())
  userId      String?     // NULL for system/platform singleton accounts
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AccountType
  currency    Currency    @default(NGN)
  createdAt   DateTime    @default(now())

  entries     LedgerEntry[]

  @@unique([userId, type, currency])
}

enum LedgerEntryType {
  DEPOSIT_CREDIT
  STAKE_LOCK
  STAKE_RELEASE
  SETTLEMENT_PAYOUT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_COMPLETE
  WITHDRAWAL_RELEASE
  ADJUSTMENT
}

model LedgerTransaction {
  id              String          @id @default(uuid())
  type            LedgerEntryType
  description     String?
  idempotencyKey  String?         @unique // prevents double-posting
  relatedMatchId  String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  entries         LedgerEntry[]

  @@index([relatedMatchId])
}

model LedgerEntry {
  id                String   @id @default(uuid())
  transactionId     String
  transaction       LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId         String
  account           LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountMinorUnits  BigInt   // signed: positive = credit, negative = debit; sum must equal 0 per transaction
  createdAt         DateTime @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
}

enum WithdrawalV2Status {
  PENDING_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  RELEASED
}

model Withdrawal {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinorUnits  BigInt
  currency          Currency          @default(NGN)
  // Server-generated payout reference, echoed to the provider as the transfer
  // reference so a payout webhook can be matched back to this row.
  reference         String            @unique
  gateway           Gateway           @default(PAYSTACK) // payout provider (from the bank account)
  bankAccountId     String?
  bankAccount       BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  status            WithdrawalV2Status @default(PENDING_REVIEW)
  providerRef       String?           @unique // provider payout id (transfer_code / transfer id)
  reviewedBy        String?
  reviewedAt        DateTime?
  processedAt       DateTime?
  failureReason     String?
  idempotencyKey    String?           // client-supplied operation key; replay returns the original row
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, status])
  @@index([bankAccountId])
  @@unique([userId, idempotencyKey])
}

model BankAccount {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway       Gateway    @default(PAYSTACK) // provider used to verify + pay out this destination
  bankCode      String     // e.g. "044" (Access Bank), "057" (Zenith)
  bankName      String
  accountNumber String
  accountName   String
  // Provider-side recipient/beneficiary id created at verification time, so a
  // payout initiation can reference it directly (Paystack recipient_code /
  // Flutterwave beneficiary id).
  recipientRef  String?
  verifiedName  String?    // name returned by the provider's account-resolution
  isDefault     Boolean    @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime   @default(now())

  withdrawals   Withdrawal[]

  @@unique([userId, accountNumber])
}

enum ReconciliationStatus {
  RUNNING
  PASSED
  FAILED
}

model FinancialReconciliationRun {
  id              String              @id @default(uuid())
  status          ReconciliationStatus @default(RUNNING)
  discrepancies   Json?               // list of detected mismatches
  checkedAt       DateTime?
  createdAt       DateTime            @default(now())
}

// ---------------------------------------------------------------------------
// Match V2 — participants, reservations, settlement, receipts
// ---------------------------------------------------------------------------

enum MatchSide {
  LIGHT
  DARK
}

model MatchParticipant {
  id        String    @id @default(uuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  side      MatchSide
  joinedAt  DateTime  @default(now())

  @@unique([matchId, userId])
  @@index([userId])
}

enum StakeReservationStatus {
  RESERVED
  RELEASED
  SETTLED
}

model StakeReservation {
  id                String                 @id @default(uuid())
  matchId           String
  match             Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinorUnits  BigInt
  status            StakeReservationStatus @default(RESERVED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([matchId, userId])
  @@index([userId, status])
}

enum MatchSettlementStatus {
  PENDING
  SETTLED
  FAILED
}

model MatchSettlement {
  id                String                 @id @default(uuid())
  matchId           String                 @unique
  match             Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerId          String?
  endReason         String
  feeSnapshotBps    Int                    // frozen PlatformSettings.commissionPercent at funding
  netPayoutMinorUnits BigInt               // winner's net payout after commission
  status            MatchSettlementStatus  @default(PENDING)
  settledAt         DateTime?
  createdAt         DateTime               @default(now())
}

model MatchReceipt {
  id                String   @id @default(uuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stakeMinorUnits   BigInt
  payoutMinorUnits  BigInt   // 0 for the loser; full net payout for the winner; full stake refund for a draw
  feeMinorUnits     BigInt   // commission taken from this player (always >= 0)
  createdAt         DateTime @default(now())

  @@unique([matchId, userId])
}

// ---------------------------------------------------------------------------
// Game V2 — durable state, events, snapshots, connection evidence
// ---------------------------------------------------------------------------

model MatchGameState {
  id                   String    @id @default(uuid())
  matchId              String    @unique
  match                Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  boardState           Json      // full 64-cell board representation
  currentTurn          MatchSide @default(LIGHT)
  stateVersion         Int       @default(0)
  whiteRemainingMs     BigInt?   // NULL for legacy matches without time controls
  blackRemainingMs     BigInt?
  turnStartedAt        DateTime?
  lastMoveId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum GameEventType {
  MOVE
  RESIGN
  DISCONNECT
  FORFEIT
  DRAW_OFFER
  DRAW_ACCEPT
  TIMEOUT
}

model GameEvent {
  id         String        @id @default(uuid())
  matchId    String
  match      Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId   String?
  type       GameEventType
  payload    Json?         // move details, reason, etc.
  createdAt  DateTime      @default(now())

  @@index([matchId, createdAt])
}

model GameStateSnapshot {
  id           String   @id @default(uuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  stateVersion Int
  boardState   Json
  createdAt    DateTime @default(now())

  @@unique([matchId, stateVersion])
}

enum ConnectionState {
  CONNECTED
  DISCONNECTED
  RECONNECTED
}

model MatchConnectionEvent {
  id         String         @id @default(uuid())
  matchId    String
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      ConnectionState
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([matchId, createdAt])
  @@index([userId, matchId])
}

// ---------------------------------------------------------------------------
// Admin / RBAC / Risk / Disputes
// ---------------------------------------------------------------------------

enum AdminRoleName {
  SUPER_ADMIN
  FINANCE
  RISK_COMPLIANCE
  SUPPORT
  GAME_OPERATIONS
  READ_ONLY_AUDITOR
}

model AdminRole {
  id          String        @id @default(uuid())
  name        AdminRoleName @unique
  description String?
  createdAt   DateTime      @default(now())

  assignments AdminRoleAssignment[]
}

model AdminRoleAssignment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy  String?
  assignedAt  DateTime @default(now())

  @@unique([userId, roleId])
}

enum RiskEventType {
  VELOCITY
  AMOUNT_ANOMALY
  MULTI_ACCOUNT
  COLLUSION
  BOT
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RiskEvent {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       RiskEventType
  severity   RiskSeverity   @default(LOW)
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum RiskCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model RiskCase {
  id          String         @id @default(uuid())
  subjectId   String         // userId under investigation
  status      RiskCaseStatus @default(OPEN)
  assignedTo  String?
  notes       Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model DisputeCase {
  id          String        @id @default(uuid())
  matchId     String
  match       Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedBy    String
  status      DisputeStatus @default(OPEN)
  reason      String
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  evidence    DisputeEvidence[]

  @@index([matchId])
  @@index([status])
}

enum DisputeEvidenceType {
  SCREENSHOT
  CHAT_LOG
  GAME_LOG
  SYSTEM_LOG
  OTHER
}

model DisputeEvidence {
  id          String              @id @default(uuid())
  caseId      String
  case        DisputeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        DisputeEvidenceType
  url         String?             // storage path
  description String?
  uploadedAt  DateTime            @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Operations — general outbox + idempotency
// ---------------------------------------------------------------------------

enum OutboxEventStatus {
  PENDING
  SENT
  FAILED
}

model OutboxEvent {
  id             String           @id @default(uuid())
  aggregateType  String           // e.g. "Match", "LedgerTransaction"
  aggregateId    String
  eventType      String           // e.g. "match.settled", "wallet.updated"
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique // client-supplied idempotency key
  scope     String?  // e.g. "deposit:intent", "withdrawal:request"
  result    Json?    // cached response
  expiresAt DateTime
  createdAt DateTime @default(now())
}
